# No secret belongs in this file. It records which variables exist and what
# each one is for; the real values live in .env.local, which is not tracked.
#
# Anything prefixed NEXT_PUBLIC_ is compiled into the browser bundle. Only one
# variable here carries that prefix, and it holds an origin, never a secret.

# Canonical origin of this portal, e.g. https://staff.example.org — origin
# only, no path. It decides whether the session cookie is marked Secure and
# whether Strict-Transport-Security is sent. Blank is honest in development.
NEXT_PUBLIC_PORTAL_URL=

# ---------------------------------------------------------------------------
# Server-only. Never give either of these a NEXT_PUBLIC_ prefix, and never
# read them from a Client Component. While either is missing no coordinator
# can sign in: /login says the portal is unavailable and every protected route
# redirects there.
# ---------------------------------------------------------------------------

# Origin of v-backend, e.g. http://localhost:4000 in development.
VOLONTYORLAR_API_URL=

# Key for the encrypted session cookie of THIS portal. At least 32 characters.
# It must differ from the administrator portal's secret and from the volunteer
# application's: a session minted for one portal must not decrypt in another.
# Generate one with: openssl rand -base64 48
VOLONTYORLAR_STAFF_SESSION_SECRET=

# Shared with v-backend's FRONTEND_PROXY_SECRET and the other frontends. With it
# the portal tells the backend which visitor each request is for, so the
# backend's rate limit counts each person instead of this server. Optional:
# while blank every visitor shares this server's budget. 32+ characters.
# Generate one with: openssl rand -base64 48
VOLONTYORLAR_PROXY_SECRET=

# ---------------------------------------------------------------------------
# Development fixture mode. Optional, refused when NODE_ENV=production.
# ---------------------------------------------------------------------------

# Set to "on" to render every screen from the labelled fixtures in
# src/lib/fixtures/ instead of calling v-backend, so the portal can be worked
# on before the backend publishes its contract. Every page then carries a
# visible "development fixtures" banner, and sign-in accepts only the fixture
# coordinator. It is inert in a production build.
VOLONTYORLAR_FIXTURES=
